# Cloudflare Pages headers.
# Security headers on every response; long-lived immutable cache for Vite's
# content-hashed assets (filenames change on every build, so this is safe).
#
# The CSP-SCRIPT-HASHES placeholder on the Content-Security-Policy line is
# replaced at build time by scripts/prerender.mjs with sha256 hashes of the
# inline <script>s in the built index.html (the theme bootstrap). If you ever
# add third-party scripts (e.g. Cloudflare Turnstile), extend script-src (and
# frame-src for Turnstile) with their origins here. `default-src 'self'`
# already covers `manifest-src` (no directive-specific fetch listed falls
# back to default-src), so manifest.webmanifest needs no extra CSP entry.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The manifest and its icons rarely change; a short cache still lets an
# updated icon/manifest show up within a day without a hard reload.
/manifest.webmanifest
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400

# HTML must revalidate so new deploys show up immediately (Pages does this by
# default, but be explicit). Every route is now a flat prerendered file
# (index.html, about.html, ...) plus 404.html — there is no SPA shell.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
