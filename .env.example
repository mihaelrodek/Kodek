# Web3Forms access key for the contact form.
#
# Consumed SERVER-SIDE by the Cloudflare Pages Function at
# functions/api/contact.ts — it is NOT exposed to the browser, so there is no
# VITE_ prefix.
#
# Get one free at https://web3forms.com (enter info@kodek.hr as the
# delivery address and copy the access key).
#
# Local dev (to exercise the Function):
#   npm run build && npx wrangler pages dev dist
# Plain `vite dev` does NOT serve /functions, so /api/contact 404s there.
#
# Production (Cloudflare Pages): add WEB3FORMS_ACCESS_KEY under
# Settings -> Environment variables (mark it encrypted), then redeploy.
WEB3FORMS_ACCESS_KEY=
